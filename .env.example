# Settings for `docker compose up` (docker-compose.yml). Copy to .env (git-ignored) and fill in.
# Keys stay inside the backend container; the browser never sees them.

# Required: the database password (any long random string).
POSTGRES_PASSWORD=change-me
# POSTGRES_USER=folio
# POSTGRES_DB=folio_ai

# The reader's address: http://localhost:8080
# FOLIO_PORT=8080

# Answers: "gemini" (free key at https://aistudio.google.com/apikey) or "anthropic" (Claude).
# Without the chosen provider's key, the reader works and the Ask tab explains what's missing.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5
# GEMINI_MODEL=gemini-3.5-flash-lite

# Embeddings: "local" runs a small CPU model in the container (no key, no cost).
# "auto" uses OpenAI when OPENAI_API_KEY is set; an account without credit makes every preparation fail.
EMBEDDING_PROVIDER=local
# OPENAI_API_KEY=

# Preparing documents (see backend/.env.example for all options)
# PARSE_THREADS=4            # CPU threads for Docling; more than the CPU's cores is slower
# PARSE_LAYOUT_MODEL=layout_egret_medium
# QUICK_INDEX=true           # answer from the PDF's text within seconds while Docling reads the layout
# PARSE_KEEP_WARM_S=300      # keep Docling loaded (~1.5 GB) this long after a document; 0 frees it at once
