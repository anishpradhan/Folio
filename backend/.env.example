# Copy to backend/.env and fill in. This file is read only by the Python backend; keys never reach the browser.

# Answers: "anthropic" (Claude) or "gemini" (Google's Gemini API; free key at https://aistudio.google.com/apikey).
# Keys stay on the server; without the chosen provider's key the chat routes return 503.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite   # free-tier quotas differ per model; see aistudio.google.com/rate-limit
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=medium        # answers: low | medium | high | xhigh | max
# LLM_AUX_EFFORT=low       # follow-up rewriting and suggested questions
# LLM_FALLBACKS=true       # server-side refusal fallbacks (a declined answer is retried on a fallback model)

# Embeddings: "auto" = OpenAI when OPENAI_API_KEY is set, otherwise a local CPU model (no key, no cost).
# An OpenAI account without credit makes every ingestion fail; use "local" then.
EMBEDDING_PROVIDER=auto
OPENAI_API_KEY=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# PostgreSQL in Docker (`npm run ai:db`). docker compose reads these same values.
POSTGRES_USER=folio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=folio_ai
POSTGRES_PORT=5432
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/db   # overrides the POSTGRES_* values

# Retrieval: the cross-encoder reranker runs only when a request asks for it (docs/ai/architecture.md §10)
# RERANK_BY_DEFAULT=false
# RERANK_CANDIDATES=12

# Vectors (default: embedded Qdrant under backend/data)
# QDRANT_URL=http://localhost:6333

# Parsing
# PARSE_TABLES=true
# PARSE_LAYOUT_MODEL=layout_egret_medium   # or layout_heron_default (Docling's default), layout_egret_large
# Answer from the PDF's text layer within seconds while Docling reads the layout (false: wait for Docling)
# QUICK_INDEX=true
# Keep the PDF reader loaded this long after a document (uses ~1-1.5 GB while loaded; 0 = never)
# PARSE_KEEP_WARM_S=300
# Stop a parse when no page finishes for this long, or after PARSE_TIMEOUT_S in total
# PARSE_STALL_S=600
# PARSE_TIMEOUT_S=14400
# PARSE_THREADS=4
# CHUNK_MAX_TOKENS=512
